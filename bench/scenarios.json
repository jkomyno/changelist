{
  "defaults": {
    "limits": { "timeoutMs": 10000, "maxCalls": 64, "concurrency": 8, "maxOutputBytes": 1048576 }
  },
  "scenarios": [
    {
      "name": "noop",
      "program": "workflows/noop.js",
      "dataset": "A",
      "tools": [],
      "profiles": ["zero"],
      "expect": { "kind": "success", "output": "noop" },
      "holdout": false
    },
    {
      "name": "triage",
      "program": "workflows/triage.js",
      "dataset": "A",
      "tools": ["tracker.list_issues", "tracker.get_issue", "directory.get_user"],
      "profiles": ["zero", "equal", "mixed"],
      "expect": { "kind": "success", "output": "triage" },
      "holdout": false
    },
    {
      "name": "triage-large",
      "program": "workflows/triage-large.js",
      "dataset": "A",
      "tools": ["tracker.list_issues_large", "tracker.get_issue", "directory.get_user"],
      "profiles": ["zero", "equal", "mixed"],
      "expect": { "kind": "success", "output": "triage-large" },
      "known_limits": {
        "codemode": "Before replies to the guest could reach 1 MiB, each listing page (~148 KiB) exceeded the 64 KiB reply frame and the run stopped with output_limit; results/baseline records that."
      },
      "holdout": false
    },
    {
      "name": "denied",
      "program": "workflows/denied.js",
      "dataset": "A",
      "tools": ["tracker.list_issues", "tracker.get_issue", "directory.get_user"],
      "profiles": ["zero", "equal", "mixed"],
      "policy": true,
      "expect": { "kind": "success", "output": "denied" },
      "holdout": false
    },
    {
      "name": "deadline",
      "program": "workflows/triage.js",
      "dataset": "A",
      "tools": ["tracker.list_issues", "tracker.get_issue", "directory.get_user"],
      "profiles": ["mixed"],
      "limits": { "timeoutMs": 250 },
      "expect": { "kind": "timeout" },
      "holdout": false
    },
    {
      "name": "guest-exception",
      "program": "workflows/guest-exception.js",
      "dataset": "A",
      "tools": ["tracker.list_issues", "tracker.get_issue", "directory.get_user"],
      "profiles": ["zero"],
      "expect": { "kind": "guest_error", "message_includes_any": ["TypeError", "undefined", "non-object value"] },
      "holdout": false
    },
    {
      "name": "lost-response",
      "program": "workflows/lost-response.js",
      "dataset": "A",
      "tools": ["tracker.list_issues", "tracker.add_label"],
      "profiles": ["mixed"],
      "add_label": "lost_response",
      "limits": { "timeoutMs": 300 },
      "expect": { "kind": "timeout", "ledger": { "effect_applied_without_complete": 1 } },
      "holdout": false
    },
    {
      "name": "release-audit",
      "program": "workflows/release-audit.js",
      "dataset": "B",
      "tools": ["vcs.list_pulls", "ci.get_checks", "directory.get_user"],
      "profiles": ["zero", "mixed"],
      "expect": { "kind": "success", "output": "release-audit" },
      "holdout": true
    }
  ]
}
